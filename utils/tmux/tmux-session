#!/usr/bin/env bash
# Save and restore a tmux session's windows and panes.
#   tmux-session save [session]   layout -> <session_path>/.vim/tmux-session
#   tmux-session restore <dir>    recreate the session saved in <dir>/.vim/tmux-session
set -e

save() {
    local session=${1:-$(tmux display -p '#S')}
    local dir
    dir=$(tmux display -p -t "=$session:" '#{session_path}')
    mkdir -p "$dir/.vim"
    tmux list-panes -s -t "=$session" -F $'#S\t#{window_index}\t#{window_name}\t#P\t#{pane_current_path}' > "$dir/.vim/tmux-session"
    tmux display-message "saved $dir/.vim/tmux-session"
}

restore() {
    local file="${1:?dir}/.vim/tmux-session" size split
    # cells are ~2x taller than wide: landscape terminal splits side by side, portrait stacks
    size=$(stty size 2>/dev/null | awk '{ printf "-x%d -y%d", $2, $1 }')
    split=$(stty size 2>/dev/null | awk '{ print ($2 > $1 * 2) ? "-h" : "-v" }' | grep . || echo -h)
    declare -A seen

    while IFS=$'\t' read -r session win name pane dir; do
        [[ -d "$dir" ]] || continue
        if ! tmux has-session -t "=$session" 2>/dev/null; then
            tmux new-session -d -s "$session" -n "$name" -c "$dir" $size
            [[ $win == 0 ]] || tmux move-window -s "$session:0" -t "$session:$win"
        elif [[ -z ${seen[$session:$win]} ]]; then
            tmux new-window -d -t "$session:$win" -n "$name" -c "$dir"
        else
            tmux split-window $split -t "$session:$win" -c "$dir"
        fi
        seen[$session:$win]=1
    done < "$file"
}

case $1 in
    save) save "$2" ;;
    restore) restore "$2" ;;
    *) echo "usage: tmux-session save [session] | restore <dir>" >&2; exit 1 ;;
esac
