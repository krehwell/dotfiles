#!/usr/bin/env bash
# Save and restore the state of tmux sessions, windows, and panes.
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Dump panes of the CURRENT session only (session, window index, window name,
# pane index, path). Using the current session instead of `-a` (all sessions on
# the server) so saving captures just the session you're in, not every open one.
dump() {
    local d=$'\t'
    local session
    session=$(tmux display-message -p '#S')
    tmux list-panes -s -t "$session" -F "#S${d}#{window_index}${d}#{window_name}${d}#P${d}#{pane_current_path}"
}

# Save session layout to a file
save() {
    dump > "$DIR"/.tmux-session
}

# Get terminal size for new sessions
terminal_size() {
    stty size 2>/dev/null | awk '{ printf "-x%d -y%d", $2, $1 }'
}

# Split direction based on terminal shape. Cells are ~2x taller than wide, so a
# landscape monitor gives cols > 2*rows; anything narrower is treated as portrait
# and panes get stacked instead of placed side by side.
split_flag() {
    stty size 2>/dev/null | awk '{ print ($2 > $1 * 2) ? "-h" : "-v" }' | grep . || echo "-h"
}

# Check if a session exists
session_exists() {
    tmux has-session -t "$1" 2>/dev/null
}

# Restore session layout from file
restore() {
    tmux start-server
    local dimensions="$(terminal_size)"
    local split="$(split_flag)"
    declare -A seen_windows

    while IFS=$'\t' read session win_index win_name pane_index dir; do
        if [[ -d "$dir" ]]; then
            local window_key="${session}:${win_index}"

            if ! session_exists "$session"; then
                tmux new-session -d -s "$session" -c "$dir" $dimensions
                tmux rename-window -t "$session:0" "$win_name"
                [[ "$win_index" != "0" ]] && tmux move-window -s "$session:0" -t "$session:$win_index"
                seen_windows["$window_key"]=1
            elif [[ -z "${seen_windows["$window_key"]}" ]]; then
                tmux new-window -d -t "$session:$win_index" -n "$win_name" -c "$dir"
                seen_windows["$window_key"]=1
            else
                tmux split-window "$split" -t "$session:$win_index" -c "$dir"
            fi
        fi
    done < "$DIR"/.tmux-session

    echo "Restored tmux sessions with windows and panes."
}


# Command-line interface
case "$1" in
    save | restore )
        $1
        ;;
    * )
        echo "valid commands: save, restore" >&2
        exit 1
esac
