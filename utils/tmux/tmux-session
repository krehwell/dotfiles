#!/usr/bin/env bash
# Save and restore a project's windows/tabs and panes. Works for tmux sessions and herdr
# workspaces (herdr when HERDR_SOCKET_PATH is set), sharing one file: <root>/.vim/tmux-session
#   tmux-session save [session|workspace]   root = tmux session_path / shortest herdr pane cwd
#   tmux-session restore [dir]              create the session/workspace, or add its missing windows
# Rows: name  window  window_name  pane  dir  [pane_name]  (tab separated; pane_name is herdr only)
set -e
export PATH="/opt/homebrew/bin:$PATH"
export LC_CTYPE=${LC_CTYPE:-en_US.UTF-8}  # tmux prints the tab separators as _ without a UTF-8 locale
herdr=${HERDR_BIN_PATH:-herdr}

tmux_save() {
    local session=${1:-$(tmux display -p '#S')} dir
    dir=$(tmux display -p -t "=$session:" '#{session_path}')
    mkdir -p "$dir/.vim"
    tmux list-panes -s -t "=$session" -F $'#S\t#{window_index}\t#{window_name}\t#P\t#{pane_current_path}' > "$dir/.vim/tmux-session"
    tmux display-message "saved $dir/.vim/tmux-session"
}

tmux_restore() {
    local file="${1:-$(tmux display -p '#{session_path}')}/.vim/tmux-session" size split
    # cells are ~2x taller than wide: landscape terminal splits side by side, portrait stacks
    size=$(stty size 2>/dev/null | awk '{ printf "-x%d -y%d", $2, $1 }')
    split=$(stty size 2>/dev/null | awk '{ print ($2 > $1 * 2) ? "-h" : "-v" }' | grep . || echo -h)
    local seen=()

    while IFS=$'\t' read -r session win name pane dir _; do
        [[ -d "$dir" ]] || continue
        if ! tmux has-session -t "=$session" 2>/dev/null; then
            tmux new-session -d -s "$session" -n "$name" -c "$dir" $size
            [[ $win == 0 ]] || tmux move-window -s "$session:0" -t "$session:$win"
        elif [[ -n ${seen[$win]:-} ]]; then
            tmux split-window $split -t "$session:$win" -c "$dir"
        elif tmux list-windows -t "=$session" -F '#{window_index}' | grep -qx "$win"; then
            continue
        else
            tmux new-window -d -t "$session:$win" -n "$name" -c "$dir"
        fi
        seen[$win]=1
    done < "$file"
    tmux display-message "restored $file"
}

herdr_panes() { "$herdr" pane list | jq -r --arg ws "$1" '.result.panes[] | select(.workspace_id == $ws) | "\(.tab_id)\t\(.cwd)\t\(.label // "")"'; }
herdr_root() { herdr_panes "$1" | cut -f2 | awk '!r || length < length(r) { r = $0 } END { print r }'; }

herdr_save() {
    local ws=${1:-${HERDR_ACTIVE_WORKSPACE_ID:-$HERDR_WORKSPACE_ID}} label dir tab cwd prev num name i=0
    label=$("$herdr" workspace get "$ws" | jq -r .result.workspace.label)
    dir=$(herdr_root "$ws")
    mkdir -p "$dir/.vim"
    while IFS=$'\t' read -r tab cwd pname; do
        if [[ $tab != "$prev" ]]; then
            read -r num name < <("$herdr" tab get "$tab" | jq -r '.result.tab | "\(.number - 1) \(.label)"')
            prev=$tab i=0
        fi
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$label" "$num" "$name" "$((i++))" "$cwd" "$pname"
    done < <(herdr_panes "$ws") > "$dir/.vim/tmux-session"
    "$herdr" notification show "saved $dir/.vim/tmux-session" >/dev/null
}

herdr_restore() {
    local ws=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}} r new count=  # count: tabs already in the workspace, set on the first row
    local dir=${1:-$(herdr_root "$ws")}
    local file="$dir/.vim/tmux-session" lock="$dir/.vim/.restore.lock"
    find "$lock" -maxdepth 0 -mmin +1 -exec rmdir {} \; 2>/dev/null || true  # stale lock from a killed run
    mkdir "$lock" 2>/dev/null || exit 0  # a restore is already running (double key press)
    trap "rmdir '$lock'" EXIT
    local tabs=()  # window -> root pane created this run

    while IFS=$'\t' read -r label win name pane cwd pname; do
        [[ -d "$cwd" ]] || continue
        new=
        if [[ -z $count ]]; then
            ws=$("$herdr" workspace list | jq -r --arg l "$label" '.result.workspaces[] | select(.label == $l) | .workspace_id')
            if [[ -z $ws ]]; then
                r=$("$herdr" workspace create --cwd "$cwd" --label "$label" --focus)
                ws=$(jq -r .result.workspace.workspace_id <<<"$r")
                "$herdr" tab rename "$(jq -r .result.tab.tab_id <<<"$r")" "$name" >/dev/null
                new=$(jq -r .result.root_pane.pane_id <<<"$r")
                tabs[$win]=$new
                count=0
            else
                count=$("$herdr" tab list --workspace "$ws" | jq '.result.tabs | length')
            fi
        fi
        if [[ -n $new ]]; then :
        elif [[ -n ${tabs[$win]:-} ]]; then
            new=$("$herdr" pane split "${tabs[$win]}" --direction right --cwd "$cwd" --no-focus | jq -r .result.pane.pane_id)
        elif (( win < count )); then
            continue  # a tab already sits at this slot, leave it alone like tmux does with an existing window
        else
            r=$("$herdr" tab create --workspace "$ws" --cwd "$cwd" --label "$name" --no-focus)
            new=$(jq -r .result.root_pane.pane_id <<<"$r")
            tabs[$win]=$new
        fi
        [[ -z $pname ]] || "$herdr" pane rename "$new" "$pname" >/dev/null
    done < "$file"
    "$herdr" notification show "restored $file" >/dev/null
}

backend=tmux; [[ -n ${HERDR_SOCKET_PATH:-} ]] && backend=herdr
case $1 in
    save | restore) "${backend}_$1" "$2" ;;
    *) echo "usage: tmux-session save [session|workspace] | restore [dir]" >&2; exit 1 ;;
esac
