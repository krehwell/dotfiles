#!/usr/bin/env bash
# Pick a project directory with fzf and jump to its tmux session or herdr workspace
# (herdr when HERDR_SOCKET_PATH is set), creating it from <dir>/.vim/tmux-session if missing.
# Usage: tmux-sessionizer [directory]
set -euo pipefail
export PATH="/opt/homebrew/bin:$PATH"
herdr=${HERDR_BIN_PATH:-herdr}
layout=${BASH_SOURCE%/*}/tmux-session

dir=${1:-$(find ~/Documents ~/Documents/personal ~/.local/share/nvim/lazy ~/.config ~/Downloads ~ ~/utils -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf)}
[[ -n $dir ]] || exit 0
name=$(basename "$dir" | tr . _)

if [[ -n ${HERDR_SOCKET_PATH:-} ]]; then
    id=$("$herdr" workspace list | jq -r --arg l "$name" '.result.workspaces[] | select(.label == $l) | .workspace_id')
    if [[ -n $id ]]; then
        "$herdr" workspace focus "$id" >/dev/null
    elif [[ -f "$dir/.vim/tmux-session" ]]; then
        "$layout" restore "$dir"
    else
        "$herdr" workspace create --cwd "$dir" --label "$name" --focus >/dev/null
    fi
    exit
fi

if ! tmux has-session -t "=$name" 2>/dev/null; then
    if [[ -f "$dir/.vim/tmux-session" ]]; then "$layout" restore "$dir"; else tmux new-session -ds "$name" -c "$dir"; fi
fi
[[ -n ${TMUX:-} ]] || exec tmux attach-session -t "=$name"

# leave a fresh numeric session (one idle shell pane) behind: kill it after switching away
current=$(tmux display -p '#{session_id}')
panes=$(tmux list-panes -s -t "$current" -F '#{session_name} #{pane_current_command}')
tmux switch-client -t "=$name"
[[ $panes =~ ^[0-9]+\ (fish|bash|zsh|sh)$ ]] && [[ $(tmux display -p -t "$current" '#S') != "$name" ]] && tmux kill-session -t "$current" || true
