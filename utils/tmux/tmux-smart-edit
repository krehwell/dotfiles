#!/bin/bash

FILE_PATH="$1"

NVIM_FZF_PROMPT="Fzf files formatter='path.dirname_first' query="

# find the first window running of nvim, vim, or vi
TARGET_WINDOW=$(tmux list-panes -a -F "#{window_id} #{pane_current_command}" | \
                grep -E "nvim|vim|vi" | head -n 1 | awk '{print $1}')

if [ -n "$TARGET_WINDOW" ]; then
    tmux send-keys -t "$TARGET_WINDOW" Escape ":" "$NVIM_FZF_PROMPT" "$FILE_PATH" Enter
    tmux select-window -t "$TARGET_WINDOW"
else
    tmux new-window -c "#{pane_current_path}" -n vi \
        "nvim +\":Fzf files formatter='path.dirname_first' query='$FILE_PATH'\"" 
fi
