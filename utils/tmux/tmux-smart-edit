#!/bin/bash
# Open "path" or "path:line" (Cmd+Shift+click in alacritty) in the editor of its project, in a tab.
# tmux while a tmux client is attached, herdr otherwise.
# A real file opens directly at its line; anything else goes to the snacks picker as a query.
export PATH="/opt/homebrew/bin:$PATH"
herdr=${HERDR_BIN_PATH:-$HOME/.local/bin/herdr}
backend=herdr; [ -n "$(tmux list-clients 2>/dev/null)" ] && backend=tmux

query="${1#@}"
file="${query%%:[0-9]*}"
line="${query#"$file"}"
line="${line#:}"
file="${file/#\~/$HOME}"
resolve() { [ "${file:0:1}" = / ] || file="$1/$file"; [ -f "$file" ] && found=1; }
ex_cmd() {
    if [ -n "${found:-}" ]; then echo ":tab drop${line:+ +$line} $file"
    else echo ":lua require(\"snacks\").picker.smart({ pattern = \"$query\" })"; fi
}
nvim_cmd() {
    if [ -n "${found:-}" ]; then echo "nvim${line:+ +$line} $file"
    else echo "nvim '+lua require(\"snacks\").picker.smart({ pattern = \"$query\" })'"; fi
}

tmux_edit() {
    local pane cmd
    resolve "$(tmux display -p '#{pane_current_path}')"
    read -r pane cmd < <(tmux list-panes -a -F '#{pane_id} #{pane_current_command} #{window_name} #{pane_current_path}' |
        awk -v file="$file" '($2 ~ /^(n?vim|vi)$/ || $3 ~ /^(n?vim|vi)$/) && index(file, $4 "/") == 1 { print $1, $2; exit }')
    [ -n "$pane" ] || pane=$(tmux new-window -P -F '#{pane_id}' -c "$(tmux display -p '#{pane_current_path}')" -n vi)
    case "$cmd" in
        nvim|vim|vi) tmux send-keys -t "$pane" Escape "$(ex_cmd)" Enter ;;
        *) tmux send-keys -t "$pane" "$(nvim_cmd)" Enter ;;
    esac
    tmux switch-client -t "$pane"
}

herdr_edit() {
    local panes ws cwd pane tab r
    panes=$("$herdr" pane list | jq -c '.result.panes[]')
    read -r ws cwd < <(jq -r 'select(.focused) | "\(.workspace_id) \(.cwd)"' <<<"$panes")
    resolve "$cwd"
    # stay in the focused workspace: its nvim pane, else its vi tab, else a new vi tab
    read -r pane tab < <(jq -r --arg ws "$ws" 'select(.workspace_id == $ws and ((.terminal_title // "") | test(" - Nvim$"))) | "\(.pane_id) \(.tab_id)"' <<<"$panes" | head -1)
    if [ -n "$pane" ]; then
        "$herdr" pane send-keys "$pane" esc >/dev/null
        "$herdr" pane send-text "$pane" "$(ex_cmd)" >/dev/null
        "$herdr" pane send-keys "$pane" enter >/dev/null
    else
        tab=$(jq -r --arg ws "$ws" 'select(.workspace_id == $ws) | .tab_id' <<<"$panes" | uniq |
            while read -r t; do "$herdr" tab get "$t" | jq -r 'select(.result.tab.label | test("^(n?vim|vi)$")) | .result.tab.tab_id'; done | head -1)
        if [ -n "$tab" ]; then
            pane=$(jq -r --arg t "$tab" 'select(.tab_id == $t) | .pane_id' <<<"$panes" | head -1)
        else
            r=$("$herdr" tab create --workspace "$ws" --cwd "$cwd" --label vi --no-focus)
            pane=$(jq -r .result.root_pane.pane_id <<<"$r")
            tab=$(jq -r .result.tab.tab_id <<<"$r")
        fi
        "$herdr" pane run "$pane" "$(nvim_cmd)" >/dev/null
    fi
    "$herdr" tab focus "$tab" >/dev/null
}

${backend}_edit
