#!/bin/bash
# Open "path" or "path:line" (Cmd+Shift+click in alacritty) in the editor window of its project.
# Editor window: named vi/nvim or running vim, with cwd above the file. None: spawn one.
# Opens in a tab, reusing the tab if the file is already open.

export PATH="/opt/homebrew/bin:$PATH"

cwd=$(tmux display -p '#{pane_current_path}')
file="${1%%:[0-9]*}"
line="${1#"$file"}"
line="${line#:}"
file="${file#@}"
file="${file/#\~/$HOME}"
[ "${file:0:1}" = / ] || file="$cwd/$file"
[ -f "$file" ] || exit 1

read -r pane cmd < <(tmux list-panes -a -F '#{pane_id} #{pane_current_command} #{window_name} #{pane_current_path}' |
    awk -v file="$file" '($2 ~ /^(n?vim|vi)$/ || $3 ~ /^(n?vim|vi)$/) && index(file, $4 "/") == 1 { print $1, $2; exit }')
[ -n "$pane" ] || pane=$(tmux new-window -P -F '#{pane_id}' -c "$cwd" -n vi)

case "$cmd" in
    nvim|vim|vi) tmux send-keys -t "$pane" Escape ":tab drop${line:+ +$line} $file" Enter ;;
    *) tmux send-keys -t "$pane" "nvim${line:+ +$line} $file" Enter ;;
esac
tmux switch-client -t "$pane"
