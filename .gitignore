# home is the repo: ignore everything, whitelist what is tracked
/*
!/.gitignore
!/README.md
!/.tmux.conf
!/utils
!/.config
/.config/*
!/.config/alacritty
!/.config/fish
!/.config/nvim
!/.config/herdr
/.config/herdr/*
!/.config/herdr/config.toml
!/.vim
/.vim/*
!/.vim/.gitkeep
**/.DS_Store
/.config/nvim/.luarc.json
